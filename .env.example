# --- Database Configuration ---
POSTGRES_DB=paycore
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# --- Backend Configuration ---
# This is the URL where the app will be hosted. 
# Used by the backend to generate payment links.
# Example: https://paycore.harshithj.me
PAYMENT_LINK_BASE_URL=https://paycore.harshithj.me

# List of allowed origins for CORS (comma separated)
# Use * for all, or specific ones: http://localhost:5173,https://your-frontend.com
ALLOWED_ORIGINS=*

# --- Frontend Configuration ---
# The frontend uses relative paths (/api) by default via Nginx proxy.
# No additional config needed unless using a separate domain for API.
